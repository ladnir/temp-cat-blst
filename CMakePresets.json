{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BLST_BUILD_SHARED": false,
        "BLST_TEST": true,
        "BLST_BENCHMARK": false,
        "BLST_CUDA": false,
        "BLST_CUDA_MSM": false,
        "BLST_FAST_BUILD": false,
        "BLST_PARALLEL_MSM": false,
        "BLST_CRNS_BATCH_VROOM_VENDOR": false
      }
    },
    {
      "name": "scalar-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "BLST_PORTABLE": false,
        "BLST_ASM": false,
        "BLST_DEFAULT_ASM": false,
        "BLST_ADX": false,
        "BLST_AVX512": false,
        "BLST_DEFAULT_AVX": false
      }
    },
    {
      "name": "assembly-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "BLST_PORTABLE": true,
        "BLST_ASM": true,
        "BLST_DEFAULT_ASM": true,
        "BLST_ADX": false,
        "BLST_AVX512": false,
        "BLST_DEFAULT_AVX": false
      }
    },
    {
      "name": "windows-x64-base",
      "hidden": true,
      "inherits": "base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x86-64 Release",
      "description": "Portable x86-64 Release build with runtime-dispatched assembly.",
      "inherits": "assembly-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-scalar",
      "displayName": "Linux x86-64 Release (scalar C++)",
      "description": "Release build without architecture-specific assembly or vector instructions.",
      "inherits": "scalar-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-native",
      "displayName": "Linux x86-64 Release (ADX/BMI2)",
      "description": "Release build requiring ADX and BMI2 on the deployment CPU.",
      "inherits": "assembly-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLST_PORTABLE": false,
        "BLST_ADX": true
      }
    },
    {
      "name": "linux-avx512",
      "displayName": "Linux x86-64 Release (AVX-512/IFMA)",
      "description": "Release build requiring the supported AVX-512/IFMA compiler and deployment CPU.",
      "inherits": "assembly-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLST_PORTABLE": false,
        "BLST_ADX": true,
        "BLST_AVX512": true,
        "BLST_DEFAULT_AVX": true
      }
    },
    {
      "name": "macos-apple-silicon",
      "displayName": "macOS Apple Silicon Release",
      "description": "Supported native arm64 macOS Release build.",
      "inherits": "assembly-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "x64-Debug",
      "displayName": "Windows x64 Debug",
      "description": "Debug build with runtime-dispatched x86-64 assembly.",
      "inherits": [
        "assembly-base",
        "windows-x64-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-Debug-Scalar",
      "displayName": "Windows x64 Debug (scalar C++)",
      "description": "Debug build without architecture-specific assembly or vector instructions.",
      "inherits": [
        "scalar-base",
        "windows-x64-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64-Release",
      "displayName": "Windows x64 Release",
      "description": "Release build with runtime-dispatched x86-64 assembly.",
      "inherits": [
        "assembly-base",
        "windows-x64-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-Release-Scalar",
      "displayName": "Windows x64 Release (scalar C++)",
      "description": "Release build without architecture-specific assembly or vector instructions.",
      "inherits": [
        "scalar-base",
        "windows-x64-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64-Release-Native",
      "displayName": "Windows x64 Release (ADX/BMI2)",
      "description": "Release build requiring ADX, BMI2, and AVX2 on the deployment CPU.",
      "inherits": [
        "assembly-base",
        "windows-x64-base"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLST_PORTABLE": false,
        "BLST_ADX": true
      }
    }
  ]
}
