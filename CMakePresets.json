{
  "version": 2,
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux",
      "description": "Target the Windows Subsystem for Linux (WSL) or a remote Linux system.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLST_PORTABLE": true,
        "BLST_ASM": true,
        "BLST_DEFAULT_ASM": true,
        "BLST_ADX": true,
        "BLST_CUDA": false,
        "CMAKE_CUDA_COMPILER": "/usr/local/cuda-13.0/bin/nvcc",
        "CMAKE_CUDA_ARCHITECTURES": "89",
        "CUDA_TOOLKIT_ROOT_DIR": "/usr/local/cuda-13.0",
        "CMAKE_PREFIX_PATH": "${sourceDir}/../out/install",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Linux"
          ]
        },
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}",
          "copySourcesOptions": {
            "exclusionList": [
              ".vs",
              "out",
              ".git"
            ]
          }
        }
      }
    },
    {
      "name": "x64-Debug",
      "displayName": "Windows x64 Debug",
      "description": "Target Windows with the Visual Studio development environment.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BLST_PORTABLE": true,
        "BLST_CUDA": false,
        "BLST_ASM": true,
        "BLST_ADX": true,
        "BLST_AVX512_PORTABLE": true,
        "BLST_DEFAULT_AVX": true,
        "BLST_BENCHMARK": true,
        "BLST_DEFAULT_ASM": false,
        "BLST_ASAN": false,
        "BLST_FAST_BUILD": true,
        "CMAKE_VERBOSE_MAKEFILE": true,
        "BLST_CUDA_MSM": false,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "x64-Debug-Scalar",
      "displayName": "Windows x64 Debug (Scalar)",
      "description": "Windows debug build with the scalar backend selected at the top-level blst API.",
      "inherits": "x64-Debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BLST_PORTABLE": false,
        "BLST_DEFAULT_AVX": false,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "x64-Debug-Avx",
      "displayName": "Windows x64 Debug (AVX)",
      "description": "Windows debug build with the AVX backend selected at the top-level blst API.",
      "inherits": "x64-Debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BLST_DEFAULT_AVX": true,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "x64-Release",
      "displayName": "Windows x64 Release",
      "description": "Target Windows with the Visual Studio development environment.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BLST_ASM": true,
        "BLST_PORTABLE": true,
        "BLST_CUDA": true,
        "BLST_CUDA_MSM": false,
        "BLST_BENCHMARK": true,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ]
        }
      }
    },
    {
      "name": "x64-Release-Scalar",
      "displayName": "Windows x64 Release (Scalar)",
      "description": "Windows release build with the scalar backend selected at the top-level blst API.",
      "inherits": "x64-Release",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BLST_PORTABLE": false,
        "BLST_DEFAULT_AVX": false,
        "BLST_CUDA": false,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    },
    {
      "name": "x64-Release-Avx",
      "displayName": "Windows x64 Release (AVX)",
      "description": "Windows release build with the AVX backend selected at the top-level blst API.",
      "inherits": "x64-Release",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BLST_DEFAULT_AVX": true,
        "BLST_AVX512_PORTABLE": true,
        "BLST_CUDA": false,
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
      }
    }
  ]
}
