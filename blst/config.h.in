/* config.h.in - generated by CMake */

#cmakedefine BLST_PORTABLE     // enable to portable code, required for cuda
#cmakedefine BLST_ASM          // enable the asm CPU code
#cmakedefine BLST_ADX          // enable the ADX instruction set
#cmakedefine BLST_DEFAULT_ASM  // use asm as the default cpu implementation
#cmakedefine BLST_CUDA         // enable cuda kernels
#cmakedefine BLST_FAST_BUILD   // faster build but slower runtime, reduced CUDA inlining.
#define BLST_LIMB_SIZE ${BLST_LIMB_SIZE}

# ifdef __CUDACC__
// this function is called from GPU code
#  define DEVICE_FUNC __device__

// this function is called from both CPU and GPU code
#  define HOST_DEVICE_FUNC __host__ __device__

// this function is called from CPU code and launches GPU code
#  define GLOBAL_FUNC __global__
# else

// this function is called from GPU code
#  define DEVICE_FUNC

// this function is called from both CPU and GPU code
#  define HOST_DEVICE_FUNC

// this function is called from CPU code and launches GPU code
#  define GLOBAL_FUNC
# endif


#ifdef __cplusplus
	#define BLST_EXTERN_C_BEGIN_ extern "C" {
	#define BLST_EXTERN_C_END_ }
#else

	#define BLST_EXTERN_C_BEGIN_
	#define BLST_EXTERN_C_END_
#endif
