/* config.h.in - generated by CMake */

#cmakedefine BLST_PORTABLE     // enable to portable code, required for cuda
#cmakedefine BLST_ASM          // enable the asm CPU code
#cmakedefine BLST_ADX          // enable the ADX instruction set
#cmakedefine BLST_DEFAULT_ASM  // use asm as the default cpu implementation
/* prefer AVX implementation as default where available */
#cmakedefine01 BLST_DEFAULT_AVX
#cmakedefine BLST_AVX512_PORTABLE     // enable portable avx 512 wrappers
#cmakedefine BLST_AVX512       // enable the AVX512 instruction set
#cmakedefine BLST_CUDA         // enable cuda kernels
#cmakedefine BLST_CUDA_MSM     // enable cuda msm kernels
#cmakedefine BLST_PARALLEL_MSM // enable parallel msm pipeline
#cmakedefine BLST_ALLOW_UNTESTED_ARM64 // allow experimental ARM64 compilation
#cmakedefine BLST_ALLOW_UNTESTED_CHERI // allow experimental CHERI compilation
#cmakedefine BLST_APPLE_ARM64_SUPPORTED // supported Apple Silicon macOS target
#cmakedefine BLST_TARGET_IS_WASM // Emscripten wasm32 scalar C++ target
#cmakedefine BLST_FAST_BUILD   // faster build but slower runtime, reduced CUDA inlining.
#define BLST_LIMB_SIZE ${BLST_LIMB_SIZE}

#if defined(BLST_TARGET_IS_WASM) && (!defined(__EMSCRIPTEN__) || !defined(__wasm32__))
# error "The WebAssembly configuration requires the Emscripten wasm32 compiler"
#endif

#if (defined(__aarch64__) || defined(__aarch64) || defined(_M_ARM64) || \
     defined(_M_ARM64EC)) && !defined(BLST_APPLE_ARM64_SUPPORTED) && \
     !defined(BLST_ALLOW_UNTESTED_ARM64)
# error "ARM64 is experimental; configure with BLST_ALLOW_UNTESTED_ARM64=ON to attempt an unsupported build"
#endif

#if defined(__CHERI_PURE_CAPABILITY__) && !defined(BLST_ALLOW_UNTESTED_CHERI)
# error "CHERI pure-capability is experimental; configure with BLST_ALLOW_UNTESTED_CHERI=ON to attempt an unsupported build"
#endif

# ifdef __CUDACC__
// this function is called from GPU code
#  define BLST_DEVICE __device__

// this function is called from both CPU and GPU code
#  define BLST_HD __host__ __device__

// this function is called from CPU code and launches GPU code
#  define BLST_GLOBAL __global__
# else

// this function is called from GPU code
#  define BLST_DEVICE

// this function is called from both CPU and GPU code
#  define BLST_HD

// this function is called from CPU code and launches GPU code
#  define BLST_GLOBAL
# endif


#ifdef __cplusplus
	#define BLST_EXTERN_C_BEGIN_ extern "C" {
	#define BLST_EXTERN_C_END_ }
#else

	#define BLST_EXTERN_C_BEGIN_
	#define BLST_EXTERN_C_END_
#endif
