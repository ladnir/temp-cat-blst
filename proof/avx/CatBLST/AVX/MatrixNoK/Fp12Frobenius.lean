def unpackFlatFp12 (x : Fp12Value R) : FlatFp12 R :=
  ![x.a.c0.x, x.a.c0.y, x.a.c1.x, x.a.c1.y, x.a.c2.x, x.a.c2.y,
    x.b.c0.x, x.b.c0.y, x.b.c1.x, x.b.c1.y, x.b.c2.x, x.b.c2.y]

@[simp] theorem pack_unpack_fp12 (x : Fp12Value R) :
    packFlatFp12 (unpackFlatFp12 x) = x := by
  ext <;> rfl

@[simp] theorem unpack_pack_fp12 (x : FlatFp12 R) :
    unpackFlatFp12 (packFlatFp12 x) = x := by
  funext i
  fin_cases i <;> rfl

/-!
## Literal source schedules

The definitions retain the exact twelve-coordinate order and the same shared
constant aliases as `Fp12Constants`.
-/

def cppFp12Frobenius1Flat (x : FlatFp12 SelectedBaseField) :
    FlatFp12 SelectedBaseField :=
  ![x 0, -x 1,
    x 3 * frob1_2, x 2 * frob1_2,
    x 4 * frob1_3, x 5 * frob1_4,
    x 7 * frob1_6 + x 6 * frob1_5,
    x 7 * frob1_6 + x 6 * frob1_6,
    x 8 * frob1_7 + x 9 * frob1_7,
    x 8 * frob1_7 + x 9 * frob1_8,
    x 11 * frob1_10 + x 10 * frob1_9,
    x 11 * frob1_10 + x 10 * frob1_10]

def cppFp12Frobenius2Flat (x : FlatFp12 SelectedBaseField) :
    FlatFp12 SelectedBaseField :=
  ![x 0, x 1,
    x 2 * frob1_4, x 3 * frob1_4,
    x 4 * frob1_2, x 5 * frob1_2,
    x 6 * frob2_3, x 7 * frob2_3,
    -x 8, -x 9,
    x 10 * frob1_3, x 11 * frob1_3]

def cppFp12Frobenius3Flat (x : FlatFp12 SelectedBaseField) :
    FlatFp12 SelectedBaseField :=
  ![x 0, -x 1, x 3, x 2, -x 4, x 5,
    x 7 * frob1_7 + x 6 * frob1_8,
    x 7 * frob1_7 + x 6 * frob1_7,
    x 8 * frob1_8 + x 9 * frob1_8,
    x 8 * frob1_8 + x 9 * frob1_7,
    x 11 * frob1_8 + x 10 * frob1_7,
    x 11 * frob1_8 + x 10 * frob1_8]

def cppFp12Frobenius1 (x : SelectedFp12) : SelectedFp12 :=
  packFlatFp12 (cppFp12Frobenius1Flat (unpackFlatFp12 x))

def cppFp12Frobenius2 (x : SelectedFp12) : SelectedFp12 :=
  packFlatFp12 (cppFp12Frobenius2Flat (unpackFlatFp12 x))

def cppFp12Frobenius3 (x : SelectedFp12) : SelectedFp12 :=
  packFlatFp12 (cppFp12Frobenius3Flat (unpackFlatFp12 x))

def fp12Basis (index : Fin 12) : SelectedFp12 :=
  packFlatFp12 (fun coordinate => if coordinate = index then 1 else 0)

def fp12BasisExpansion (x : SelectedFp12) : SelectedFp12 :=
  ∑ index : Fin 12,
    scalar (unpackFlatFp12 x index) * fp12Basis index

theorem fp12_basis_expansion (x : SelectedFp12) :
    fp12BasisExpansion x = x := by
  ext <;>
    simp [fp12BasisExpansion, fp12Basis, unpackFlatFp12, packFlatFp12,
      Fin.sum_univ_succ, scalar, Fp12Concrete.add, Fp12Value.mul,
      Fp6Value.add, Fp6Value.mul, Fp6Value.mulByV, Fp2Value.add,
      Fp2Value.mul, Fp2Value.mulByNonresidue]

def fp12W : SelectedFp12 := fp12Basis 6

def fp12BasisPolynomial (z : SelectedFp12) : Fin 12 → SelectedFp12 :=
  ![1, z ^ 6 - 1, z ^ 2, z ^ 8 - z ^ 2, z ^ 4, z ^ 10 - z ^ 4,
    z, z ^ 7 - z, z ^ 3, z ^ 9 - z ^ 3, z ^ 5, z ^ 11 - z ^ 5]

theorem fp12_small_power_facts :
    fp12W ^ 19 = scalar (-2 : SelectedBaseField) * fp12Basis 6 +
        scalar (2 : SelectedBaseField) * fp12Basis 7 ∧
      fp12W ^ 24 = scalar (-4 : SelectedBaseField) ∧
      ∀ index : Fin 12, fp12BasisPolynomial fp12W index = fp12Basis index := by
  native_decide

theorem fp12_w_pow_19 :
    fp12W ^ 19 = scalar (-2 : SelectedBaseField) * fp12Basis 6 +
      scalar (2 : SelectedBaseField) * fp12Basis 7 :=
  fp12_small_power_facts.1

theorem fp12_w_pow_24 :
    fp12W ^ 24 = scalar (-4 : SelectedBaseField) :=
  fp12_small_power_facts.2.1

theorem fp12_basis_polynomial_at_w (index : Fin 12) :
    fp12BasisPolynomial fp12W index = fp12Basis index :=
  fp12_small_power_facts.2.2 index

def frobenius1Quotient : Nat := Generated.target_modulus / 24

def frobenius1Coefficient : SelectedBaseField :=
  (-4 : SelectedBaseField) ^ frobenius1Quotient

theorem target_modulus_frobenius1_decomposition :
    Generated.target_modulus = 24 * frobenius1Quotient + 19 := by
  norm_num [Generated.target_modulus, frobenius1Quotient]

theorem frobenius1_w_coefficients :
    (-2 : SelectedBaseField) * frobenius1Coefficient = frob1_5 ∧
      (2 : SelectedBaseField) * frobenius1Coefficient = frob1_6 := by
  native_decide

theorem frobenius1_w_reduced_schedule :
    scalar frobenius1Coefficient *
        (scalar (-2 : SelectedBaseField) * fp12Basis 6 +
          scalar (2 : SelectedBaseField) * fp12Basis 7) =
      cppFp12Frobenius1 fp12W := by
  native_decide

theorem selected_frobenius1_w :
    frobenius SelectedFp12 Generated.target_modulus fp12W =
      cppFp12Frobenius1 fp12W := by
  rw [frobenius_def]
  calc
    fp12W ^ Generated.target_modulus =
        fp12W ^ (24 * frobenius1Quotient + 19) :=
      congrArg (fun exponent => fp12W ^ exponent)
        target_modulus_frobenius1_decomposition
    _ = cppFp12Frobenius1 fp12W := by
      rw [pow_add, pow_mul, fp12_w_pow_24, fp12_scalar_pow,
        fp12_w_pow_19]
      change scalar frobenius1Coefficient *
          (scalar (-2 : SelectedBaseField) * fp12Basis 6 +
            scalar (2 : SelectedBaseField) * fp12Basis 7) = _
      exact frobenius1_w_reduced_schedule

theorem frobenius1_basis_polynomial (z : SelectedFp12)
    (index : Fin 12) :
    frobenius SelectedFp12 Generated.target_modulus
        (fp12BasisPolynomial z index) =
      fp12BasisPolynomial
        (frobenius SelectedFp12 Generated.target_modulus z) index := by
  fin_cases index <;>
    simp [fp12BasisPolynomial, map_sub, map_pow]

theorem cpp_frobenius1_basis_schedule :
    ∀ index : Fin 12,
      fp12BasisPolynomial (cppFp12Frobenius1 fp12W) index =
        cppFp12Frobenius1 (fp12Basis index) := by
  native_decide

theorem selected_frobenius1_basis (index : Fin 12) :
    frobenius SelectedFp12 Generated.target_modulus (fp12Basis index) =
      cppFp12Frobenius1 (fp12Basis index) := by
  calc
    frobenius SelectedFp12 Generated.target_modulus (fp12Basis index) =
        frobenius SelectedFp12 Generated.target_modulus
          (fp12BasisPolynomial fp12W index) :=
      congrArg (frobenius SelectedFp12 Generated.target_modulus)
        (fp12_basis_polynomial_at_w index).symm
    _ = fp12BasisPolynomial
          (frobenius SelectedFp12 Generated.target_modulus fp12W) index :=
      frobenius1_basis_polynomial fp12W index
    _ = fp12BasisPolynomial (cppFp12Frobenius1 fp12W) index := by
      rw [selected_frobenius1_w]
    _ = cppFp12Frobenius1 (fp12Basis index) :=
      cpp_frobenius1_basis_schedule index

theorem selected_frobenius1_scalar (x : SelectedBaseField) :
    frobenius SelectedFp12 Generated.target_modulus (scalar x) = scalar x := by
  rw [frobenius_def, fp12_scalar_pow, ZMod.pow_card]

theorem cpp_frobenius1_basis_expansion (x : SelectedFp12) :
    cppFp12Frobenius1 x =
      ∑ index : Fin 12,
        scalar (unpackFlatFp12 x index) *
          cppFp12Frobenius1 (fp12Basis index) := by
  ext <;>
    simp [cppFp12Frobenius1, cppFp12Frobenius1Flat,
      fp12Basis, unpackFlatFp12, packFlatFp12, Fin.sum_univ_succ,
      scalar, Fp12Concrete.add, Fp12Value.mul, Fp6Value.add,
      Fp6Value.mul, Fp6Value.mulByV, Fp2Value.add, Fp2Value.mul,
      Fp2Value.mulByNonresidue] <;>
    ring

theorem cpp_selected_fp12_frobenius1_correct (x : SelectedFp12) :
    cppFp12Frobenius1 x =
      frobenius SelectedFp12 Generated.target_modulus x := by
  rw [cpp_frobenius1_basis_expansion]
  have mappedExpansion :
      frobenius SelectedFp12 Generated.target_modulus
          (fp12BasisExpansion x) =
        ∑ index : Fin 12,
          scalar (unpackFlatFp12 x index) *
            cppFp12Frobenius1 (fp12Basis index) := by
    simp only [fp12BasisExpansion, map_sum, map_mul,
      selected_frobenius1_scalar, selected_frobenius1_basis]
  rw [fp12_basis_expansion] at mappedExpansion
  exact mappedExpansion.symm

end CatBLST.AVX.MatrixNoK
