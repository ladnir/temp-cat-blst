import CatBLST.AVX.MatrixNoK.Fp12Algebra
import CatBLST.AVX.MatrixNoK.TargetPrime
import Mathlib.Algebra.CharP.Frobenius
import Mathlib.Tactic

set_option maxHeartbeats 800000

/-!
# Selected MatrixNoK Fp12 Frobenius maps

This file maps the literal C++ Frobenius schedules and generated MatrixNoK
constants to exponentiation by `p`, `p^2`, and `p^3` in the concrete tower.
-/

namespace CatBLST.AVX.MatrixNoK

open Fp12Concrete

abbrev SelectedBaseField := ZMod Generated.target_modulus
abbrev SelectedFp12 := Fp12Value SelectedBaseField

@[simp] theorem fp12_add_def {R : Type*} [CommRing R]
    (x y : Fp12Value R) : x + y = Fp12Concrete.add x y := rfl

@[simp] theorem fp12_mul_def {R : Type*} [CommRing R]
    (x y : Fp12Value R) : x * y = Fp12Value.mul x y := rfl

def fp12ScalarHom (R : Type*) [CommRing R] : R →+* Fp12Value R where
  toFun := scalar
  map_one' := rfl
  map_mul' := by
    intro x y
    ext <;>
      simp [scalar, Fp12Value.mul, Fp6Value.add, Fp6Value.mul,
        Fp6Value.mulByV, Fp2Value.add, Fp2Value.mul,
        Fp2Value.mulByNonresidue]
  map_zero' := rfl
  map_add' := by
    intro x y
    ext <;> simp [scalar, Fp12Concrete.add, Fp6Value.add, Fp2Value.add]

@[simp] theorem fp12_scalar_pow {R : Type*} [CommRing R]
    (x : R) (n : Nat) :
    scalar x ^ n = scalar (x ^ n) := by
  exact (map_pow (fp12ScalarHom R) x n).symm

