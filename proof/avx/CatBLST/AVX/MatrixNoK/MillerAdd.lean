import CatBLST.AVX.MatrixNoK.MillerSparseMul
import Mathlib.Tactic

set_option maxHeartbeats 800000

/-!
# Source-shaped Miller mixed-addition geometry

This file models the literal intermediates in `Miller::add_step`.  The affine
addend has homogeneous `z = 1`.  The emitted line is kept separate from its G1
scaling so the direct and prepared paths can share one geometric statement.
-/

namespace CatBLST.AVX.MatrixNoK

structure MillerAddResult (K : Type*) where
  point : HomogeneousPoint K
  line : MillerLine K
  deriving DecidableEq

/-- Literal reduced algebra of C++ `Miller::add_step`. -/
def cppMillerAdd [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K) :
    MillerAddResult K :=
  let x2x1 := addendX * point.x
  let x2y1 := addendX * point.y
  let x2z1 := addendX * point.z
  let y2x1 := addendY * point.x
  let y2y1 := addendY * point.y
  let y2z1 := addendY * point.z
  let lineC := x2y1 - y2x1
  let lineX := y2z1 - point.y
  let lineY := point.x - x2z1
  let x2y1PlusY2x1 := x2y1 + y2x1
  let y2z1PlusY1 := y2z1 + point.y
  let x2z1PlusX1 := x2z1 + point.x
  let threeX2x1 := 3 * x2x1
  let b3z1 := 3 * b * point.z
  let y2y1PlusB3z1 := y2y1 + b3z1
  let y2y1MinusB3z1 := y2y1 - b3z1
  let b3X2z1PlusX1 := 3 * b * x2z1PlusX1
  let t2 := x2y1PlusY2x1 * y2y1MinusB3z1
  let pointOut : HomogeneousPoint K :=
    ⟨t2 - b3X2z1PlusX1 * y2z1PlusY1,
      b3X2z1PlusX1 * threeX2x1 +
        y2y1PlusB3z1 * y2y1MinusB3z1,
      y2y1PlusB3z1 * y2z1PlusY1 +
        x2y1PlusY2x1 * threeX2x1⟩
  ⟨pointOut, ⟨lineC, lineX, lineY⟩⟩

/-- Direct path after multiplication of the two nonconstant terms by G1. -/
def cppMillerAddDirectLine [CommRing K]
    (point : HomogeneousPoint K) (addendX addendY g1x g1y : K) :
    MillerLine K :=
  ⟨addendX * point.y - addendY * point.x,
    (addendY * point.z - point.y) * g1x,
    (point.x - addendX * point.z) * g1y⟩

theorem cpp_miller_add_line_coordinates [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K) :
    (cppMillerAdd b point addendX addendY).line =
      ⟨addendX * point.y - addendY * point.x,
        addendY * point.z - point.y,
        point.x - addendX * point.z⟩ := by
  rfl

theorem cpp_miller_add_prepared_line_matches_direct [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY g1x g1y : K) :
    (cppMillerAdd b point addendX addendY).line.scaleForG1 g1x g1y =
      cppMillerAddDirectLine point addendX addendY g1x g1y := by
  rw [cpp_miller_add_line_coordinates]
  rfl

theorem cpp_miller_add_line_contains_input [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K) :
    (cppMillerAdd b point addendX addendY).line.evaluateHomogeneous point = 0 := by
  rw [cpp_miller_add_line_coordinates]
  simp only [MillerLine.evaluateHomogeneous]
  ring

theorem cpp_miller_add_line_contains_addend [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K) :
    (cppMillerAdd b point addendX addendY).line.evaluateHomogeneous
        ⟨addendX, addendY, 1⟩ = 0 := by
  rw [cpp_miller_add_line_coordinates]
  simp only [MillerLine.evaluateHomogeneous]
  ring

theorem cpp_miller_add_line_contains_negative_output [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K)
    (pointOnCurve : point.onCurve b)
    (addendOnCurve : (⟨addendX, addendY, 1⟩ : HomogeneousPoint K).onCurve b) :
    (cppMillerAdd b point addendX addendY).line.evaluateHomogeneous
        (cppMillerAdd b point addendX addendY).point.negate = 0 := by
  simp only [HomogeneousPoint.onCurve] at pointOnCurve addendOnCurve
  rw [cpp_miller_add_line_coordinates]
  simp only [MillerLine.evaluateHomogeneous, HomogeneousPoint.negate,
    cppMillerAdd]
  linear_combination
    (-3 * point.x * (point.y ^ 2 + 3 * b * point.z ^ 2)) *
        addendOnCurve +
      (3 * addendX * (addendY ^ 2 - addendX ^ 3 - b) +
        3 * addendX * (addendX ^ 3 + 4 * b)) * pointOnCurve

/-!
The following two coefficients are a checked polynomial certificate for curve
preservation.  They were generated by reducing the literal output-curve
polynomial by the input and affine-addend curve equations.  Lean's
`linear_combination` tactic independently normalizes and checks the identity.
-/

private def millerAddPointCurveCertificate [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K) : K :=
  -243*b^3*point.x*addendX^2*point.y*point.z
    + 243*b^3*point.x*addendX^2*addendY*point.z^2
    + 243*b^3*addendX^3*addendY*point.z^3
    - 27*b^3*point.y^3
    - 162*b^3*point.y^2*addendY*point.z
    - 324*b^3*point.y*addendY^2*point.z^2
    - 216*b^3*addendY^3*point.z^3
    - 243*b^2*point.x^3*addendX^3*addendY
    - 243*b^2*point.x^2*addendX^4*point.y
    - 486*b^2*point.x^2*addendX^4*addendY*point.z
    - 486*b^2*point.x*addendX^5*point.y*point.z
    - 243*b^2*point.x*addendX^5*addendY*point.z^2
    - 81*b^2*point.x*addendX^2*point.y^2*addendY
    + 81*b^2*point.x*addendX^2*addendY^3*point.z^2
    - 243*b^2*addendX^6*point.y*point.z^2
    - 243*b^2*addendX^3*point.y^2*addendY*point.z
    - 27*b^2*addendX^3*addendY^3*point.z^3
    + 27*b^2*point.y^3*addendY^2
    + 108*b^2*point.y^2*addendY^3*point.z
    + 108*b^2*point.y*addendY^4*point.z^2
    + 27*b*point.x^3*addendX^3*addendY^3
    + 81*b*point.x^2*addendX^4*point.y*addendY^2
    + 81*b*point.x*addendX^5*point.y^2*addendY
    - 27*b*point.x*addendX^2*point.y^2*addendY^3
    + 27*b*point.x*addendX^2*point.y*addendY^4*point.z
    + 27*b*addendX^6*point.y^3
    + 27*b*addendX^3*point.y^2*addendY^3*point.z
    - 9*b*point.y^3*addendY^4
    - 18*b*point.y^2*addendY^5*point.z
    + point.y^3*addendY^6

private def millerAddAddendCurveCertificate [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K) : K :=
  -243*b^4*point.y*point.z^5
    - 243*b^4*addendY*point.z^6
    + 486*b^3*point.x^2*addendX*point.y*point.z^3
    + 243*b^3*point.x^2*addendX*addendY*point.z^4
    + 486*b^3*point.x*addendX^2*point.y*point.z^4
    + 243*b^3*point.x*addendX^2*addendY*point.z^5
    + 243*b^3*addendX^3*point.y*point.z^5
    + 54*b^3*point.y^3*point.z^3
    + 162*b^3*point.y^2*addendY*point.z^4
    + 81*b^3*point.y*addendY^2*point.z^5
    - 162*b^2*point.x^2*addendX*point.y^3*point.z
    - 486*b^2*point.x^2*addendX*point.y^2*addendY*point.z^2
    - 162*b^2*point.x^2*addendX*point.y*addendY^2*point.z^3
    - 486*b^2*point.x*addendX^2*point.y^3*point.z^2
    - 324*b^2*point.x*addendX^2*point.y^2*addendY*point.z^3
    - 270*b^2*addendX^3*point.y^3*point.z^3
    - 27*b^2*point.y^5*point.z
    - 135*b^2*point.y^4*addendY*point.z^2
    - 162*b^2*point.y^3*addendY^2*point.z^3
    - 27*b^2*point.y^2*addendY^3*point.z^4
    + 27*b*point.x^2*addendX*point.y^4*addendY
    + 54*b*point.x^2*addendX*point.y^3*addendY^2*point.z
    + 81*b*point.x*addendX^2*point.y^4*addendY*point.z
    + 27*b*addendX^3*point.y^5*point.z
    + 9*b*point.y^5*addendY^2*point.z
    + 18*b*point.y^4*addendY^3*point.z^2
    + point.y^6*addendY^3

private theorem cpp_miller_add_curve_certificate [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K) :
    let output := (cppMillerAdd b point addendX addendY).point
    output.y ^ 2 * output.z - output.x ^ 3 - b * output.z ^ 3 =
      millerAddPointCurveCertificate b point addendX addendY *
          (point.y ^ 2 * point.z - point.x ^ 3 - b * point.z ^ 3) +
        millerAddAddendCurveCertificate b point addendX addendY *
          (addendY ^ 2 - addendX ^ 3 - b) := by
  simp only [cppMillerAdd, millerAddPointCurveCertificate,
    millerAddAddendCurveCertificate]
  ring

theorem cpp_miller_add_preserves_curve [CommRing K]
    (b : K) (point : HomogeneousPoint K) (addendX addendY : K)
    (pointOnCurve : point.onCurve b)
    (addendOnCurve : (⟨addendX, addendY, 1⟩ : HomogeneousPoint K).onCurve b) :
    (cppMillerAdd b point addendX addendY).point.onCurve b := by
  simp only [HomogeneousPoint.onCurve] at pointOnCurve addendOnCurve ⊢
  have addendEquation : addendY ^ 2 = addendX ^ 3 + b := by
    simpa using addendOnCurve
  have certificate := cpp_miller_add_curve_certificate b point addendX addendY
  rw [pointOnCurve, addendEquation] at certificate
  ring_nf at certificate
  linear_combination certificate

theorem selected_cpp_miller_add_correct
    (b : SelectedMillerFp2)
    (point : HomogeneousPoint SelectedMillerFp2)
    (addendX addendY : SelectedMillerFp2)
    (pointOnCurve : point.onCurve b)
    (addendOnCurve :
      (⟨addendX, addendY, 1⟩ : HomogeneousPoint SelectedMillerFp2).onCurve b) :
    (cppMillerAdd b point addendX addendY).point.onCurve b ∧
      (cppMillerAdd b point addendX addendY).line.evaluateHomogeneous point = 0 ∧
      (cppMillerAdd b point addendX addendY).line.evaluateHomogeneous
        ⟨addendX, addendY, 1⟩ = 0 ∧
      (cppMillerAdd b point addendX addendY).line.evaluateHomogeneous
        (cppMillerAdd b point addendX addendY).point.negate = 0 := by
  exact ⟨cpp_miller_add_preserves_curve b point addendX addendY
      pointOnCurve addendOnCurve,
    cpp_miller_add_line_contains_input b point addendX addendY,
    cpp_miller_add_line_contains_addend b point addendX addendY,
    cpp_miller_add_line_contains_negative_output b point addendX addendY
      pointOnCurve addendOnCurve⟩

end CatBLST.AVX.MatrixNoK
